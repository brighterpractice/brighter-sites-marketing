---
import { clientPortalUrl } from '../data/site';

const currentRelease = 'v1.0';
---

<footer class="site-footer">
  <div class="container footer-main">
    <div>
      <a class="footer-brand" href="/">Brighter Sites</a>
      <p>
        Professional websites for therapists and counseling practices.
      </p>
    </div>

    <div class="footer-links">
      <a href="/work/">Work</a>
      <a href="/services/">Pricing & Services</a>
      <a href="/website-strategy/">Website Strategy</a>
      <a href="/faq/">FAQ</a>
      <a href="/process/">Process</a>
      <a href="/contact/">Contact</a>
      <a
        href="https://www.linkedin.com/in/isaac-bright-9b8051433/"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
      <a href={clientPortalUrl}>Client Portal</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Brighter Sites</span>
    <span>Thoughtful design. Professional results.</span>
  </div>

  <div class="container brighter-sites-signature">
    <span>Established August 2026 · Current Release {currentRelease}</span>
    <span>
      Website built and managed by{' '}
      <a href="https://brightersites.app">Brighter Sites</a>
    </span>
  </div>
</footer>
