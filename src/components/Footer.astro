---
import { clientPortalUrl } from '../data/site';

const lastUpdated = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/Denver',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
  timeZoneName: 'short',
}).format(new Date());
---

<footer class="site-footer">
  <div class="container footer-main">
    <div>
      <a class="footer-brand" href="/">Brighter Sites</a>
      <p>
        Professional websites for therapists and counseling practices.
      </p>
    </div>

    <div class="footer-links">
      <a href="/work/">Work</a>
      <a href="/services/">Pricing & Services</a>
      <a href="/process/">Process</a>
      <a href="/contact/">Contact</a>
      <a href={clientPortalUrl}>Client Portal</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Brighter Sites</span>
    <span>Thoughtful design. Professional results.</span>
  </div>

  <div class="container brighter-sites-signature">
    <span>Site last updated {lastUpdated}</span>
    <span>
      Website built and managed by{" "}
      <a href="https://brightersites.app">Brighter Sites</a>
    </span>
  </div>
</footer>
