---
import { clientPortalUrl, navigation, primaryCta } from '../data/site';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Brighter Sites home">
      <img
        class="brand-logo"
        src="/images/branding/brighter-sites-wordmark.png"
        alt="Brighter Sites — Thoughtful websites for therapists"
        width="760"
        height="289"
        fetchpriority="high"
      />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="client-portal-nav-link" href={clientPortalUrl}>
        <img
          class="client-portal-nav-icon"
          src="/images/branding/client-portal-icon.svg"
          alt=""
          width="96"
          height="96"
          aria-hidden="true"
        />
        <span>Client Portal</span>
      </a>
    </nav>

    <a class="header-cta desktop-cta" href={primaryCta}>
      Start a project
    </a>

    <details class="mobile-nav-details">
      <summary
        class="mobile-menu-button"
        aria-label="Open navigation"
      >
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <nav
        class="mobile-menu"
        id="mobile-navigation"
        aria-label="Mobile navigation"
      >
        <div class="container mobile-menu-inner">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>

          {
            navigation.map((item) => (
              <a
                href={item.href}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }

          <a class="client-portal-nav-link client-portal-nav-link--mobile" href={clientPortalUrl}>
            <img
              class="client-portal-nav-icon"
              src="/images/branding/client-portal-icon.svg"
              alt=""
              width="96"
              height="96"
              aria-hidden="true"
            />
            <span>Client Portal</span>
          </a>

          <a class="mobile-menu-cta" href={primaryCta}>
            Start a project
          </a>
        </div>
      </nav>
    </details>
  </div>
</header>

<script>
  const mobileNav = document.querySelector<HTMLDetailsElement>('.mobile-nav-details');
  const mobileMenuButton = mobileNav?.querySelector<HTMLElement>('.mobile-menu-button');

  const closeMobileNav = () => {
    if (!mobileNav?.open) return;
    mobileNav.removeAttribute('open');
    mobileMenuButton?.setAttribute('aria-label', 'Open navigation');
  };

  mobileNav?.addEventListener('toggle', () => {
    mobileMenuButton?.setAttribute(
      'aria-label',
      mobileNav.open ? 'Close navigation' : 'Open navigation',
    );
  });

  document.addEventListener('pointerdown', (event) => {
    if (!mobileNav?.open) return;
    if (event.target instanceof Node && !mobileNav.contains(event.target)) {
      closeMobileNav();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMobileNav();
      mobileMenuButton?.focus();
    }
  });
</script>

<style>
  .client-portal-nav-link {
    display: inline-flex;
    align-items: center;
    gap: .42rem;
  }

  .client-portal-nav-icon {
    width: 1.45rem;
    height: 1.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(16,43,50,.15);
  }

  .client-portal-nav-link--mobile {
    width: fit-content;
  }

  @media (max-width: 47.99rem) {
    .client-portal-nav-icon {
      width: 1.7rem;
      height: 1.7rem;
    }
  }
</style>
