---
import { navigation, primaryCta } from '../data/site';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Brighter Sites home">
      <img
        class="brand-logo"
        src="/images/branding/brighter-sites-wordmark.png"
        alt="Brighter Sites — Thoughtful websites for therapists"
        width="760"
        height="289"
        fetchpriority="high"
      />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="header-cta desktop-cta" href={primaryCta}>
      Start a project
    </a>

    <details class="mobile-nav-details">
      <summary
        class="mobile-menu-button"
        aria-label="Open navigation"
      >
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <nav
        class="mobile-menu"
        id="mobile-navigation"
        aria-label="Mobile navigation"
      >
        <div class="container mobile-menu-inner">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>

          {
            navigation.map((item) => (
              <a
                href={item.href}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }

          <a class="mobile-menu-cta" href={primaryCta}>
            Start a project
          </a>
        </div>
      </nav>
    </details>
  </div>
</header>
