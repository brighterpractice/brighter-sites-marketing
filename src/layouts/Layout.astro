---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/work-preview-refinements.css';

interface Props {
  title?: string;
  description?: string;
  hideConsultationCta?: boolean;
  additionalSchema?: Record<string, unknown>[];
}

const {
  title = 'Custom Website Design for Small Businesses | Brighter Sites',
  description = 'Custom website design, technical SEO, analytics, and ongoing web management for small businesses. Specialized experience with therapists, counselors, coaches, and wellness professionals.',
  hideConsultationCta = false,
  additionalSchema = [],
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const socialImageUrl = new URL(
  '/images/branding/brighter-sites-icon.png',
  Astro.site
).toString();
const showConsultationCta =
  !hideConsultationCta && Astro.url.pathname !== '/contact/';
const showHomePositioning = Astro.url.pathname === '/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://brightersites.app/#business',
      name: 'Brighter Sites',
      url: 'https://brightersites.app/',
      logo: 'https://brightersites.app/images/branding/brighter-sites-icon.png',
      description:
        'Custom website design, technical SEO foundations, local search setup, analytics, digital presence support, and ongoing website management for small businesses, with specialized experience serving therapists, counselors, coaches, and wellness professionals.',
      email: 'help@brightersites.app',
      priceRange: '$29–$2,000+',
      areaServed: [
        { '@type': 'Country', name: 'United States' },
        { '@type': 'Place', name: 'Treasure Valley, Idaho' },
        { '@type': 'City', name: 'Meridian, Idaho' },
        { '@type': 'City', name: 'Boise, Idaho' },
        { '@type': 'City', name: 'Eagle, Idaho' },
        { '@type': 'City', name: 'Nampa, Idaho' },
        { '@type': 'City', name: 'Kuna, Idaho' },
        { '@type': 'City', name: 'Star, Idaho' },
      ],
      knowsAbout: [
        'Small business website design',
        'Therapist website design',
        'Counselor website design',
        'Coaching website design',
        'Wellness professional website design',
        'Website development',
        'Technical SEO',
        'Local search visibility',
        'Google Business Profile',
        'Google Search Console',
        'Website analytics',
        'Domain and DNS management',
        'Website performance',
        'Ongoing website management',
      ],
      founder: {
        '@id': 'https://brightersites.app/#isaac-bright',
      },
      makesOffer: [
        {
          '@type': 'Offer',
          name: 'Founding Practice Program',
          url: 'https://brightersites.app/services/',
          price: '1250',
          priceCurrency: 'USD',
          description:
            'Professional Website founding starting price for qualifying founding-practice projects.',
          itemOffered: {
            '@type': 'Service',
            name: 'Custom Website Design',
            serviceType: 'Small Business Website Design',
          },
        },
        {
          '@type': 'Offer',
          url: 'https://brightersites.app/therapist-websites/',
          itemOffered: {
            '@type': 'Service',
            name: 'Website Design for Therapists and Counselors',
            serviceType: 'Mental Health Web Design',
          },
        },
        {
          '@type': 'Offer',
          url: 'https://brightersites.app/coaching-websites/',
          itemOffered: {
            '@type': 'Service',
            name: 'Website Design for Coaches',
            serviceType: 'Coaching Web Design',
          },
        },
      ],
    },
    {
      '@type': 'Person',
      '@id': 'https://brightersites.app/#isaac-bright',
      name: 'Isaac Bright',
      url: 'https://brightersites.app/about/',
      jobTitle: 'Founder, Designer, and Developer',
      worksFor: {
        '@id': 'https://brightersites.app/#business',
      },
      sameAs: [
        'https://www.linkedin.com/in/isaac-bright-9b8051433/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://brightersites.app/#website',
      url: 'https://brightersites.app/',
      name: 'Brighter Sites',
      publisher: {
        '@id': 'https://brightersites.app/#business',
      },
    },
    ...additionalSchema,
  ],
};

const analyticsConfig = JSON.stringify({
  collectorUrl: 'https://analytics.brightersites.app',
  siteKey: 'bs_live_495e5683c0b08bdfb1c856aff92f9abcb2f2cd8ee0b09a24',
  scriptVersion: '2.2.0',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Brighter Sites" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Brighter Sites" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Brighter Sites" />

    <meta name="theme-color" content="#102b32" />
    <link rel="icon" type="image/png" href="/images/branding/brighter-sites-favicon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <main id="main">
      {
        showHomePositioning && (
          <section class="home-positioning-strip" aria-label="Who Brighter Sites serves">
            <div class="container home-positioning-inner">
              <strong>Websites & digital presence for small businesses</strong>
              <span>
                Serving businesses broadly, with specialized experience in therapy,
                counseling, coaching, wellness, and other trust-based services.
              </span>
              <a href="/small-business-websites/">Small-business services →</a>
              <a href="/treasure-valley-website-design/">Treasure Valley →</a>
            </div>
          </section>
        )
      }

      <slot />
    </main>

    {
      showConsultationCta && (
        <section class="section">
          <div class="container">
            <div class="cta-panel">
              <p class="eyebrow">Free 15-minute website consultation</p>
              <h2>Have questions before you get started?</h2>
              <p>
                Talk through your current website, what your business needs, and
                whether Brighter Sites is a good fit. Consultations are held
                online through Google Meet, with no pressure or obligation.
              </p>
              <a class="button secondary" href="/contact/#consultation">
                Request a free 15-minute consultation
              </a>
            </div>
          </div>
        </section>
      )
    }

    <Footer />

  <script
    is:inline
    type="application/json"
    data-bs-analytics-config
    set:html={analyticsConfig}
  ></script>
  <script
    is:inline
    src="/brighter-analytics.js?v=2.2.0"
    defer
  ></script>
</body>
</html>

<style>
  .home-positioning-strip {
    border-bottom: 1px solid var(--line);
    background: white;
  }

  .home-positioning-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .35rem .8rem;
    padding-top: .7rem;
    padding-bottom: .7rem;
    font-size: .78rem;
    line-height: 1.45;
  }

  .home-positioning-inner strong {
    color: var(--ink);
  }

  .home-positioning-inner span {
    color: var(--body);
  }

  .home-positioning-inner a {
    color: var(--teal-dark);
    font-weight: 750;
    text-decoration: none;
  }

  .home-positioning-inner a:hover {
    text-decoration: underline;
  }
</style>
