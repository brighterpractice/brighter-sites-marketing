---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/work-preview-refinements.css';

interface Props {
  title?: string;
  description?: string;
  hideConsultationCta?: boolean;
}

const {
  title = 'Small Business Website Design & Digital Presence | Brighter Sites',
  description = 'Custom websites, technical SEO foundations, local search setup, analytics, and digital presence support for small businesses, with specialized experience serving therapists, counselors, coaches, and wellness professionals.',
  hideConsultationCta = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const socialImageUrl = new URL(
  '/images/branding/brighter-sites-icon.png',
  Astro.site
).toString();
const showConsultationCta =
  !hideConsultationCta && Astro.url.pathname !== '/contact/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://brightersites.app/#organization',
      name: 'Brighter Sites',
      url: 'https://brightersites.app/',
      logo: 'https://brightersites.app/images/branding/brighter-sites-icon.png',
      description:
        'Custom website design, technical SEO foundations, local search setup, analytics, digital presence support, and ongoing website management for small businesses, with specialized experience serving therapists, counselors, coaches, and wellness professionals.',
      email: 'help@brightersites.app',
      areaServed: [
        { '@type': 'Place', name: 'Treasure Valley, Idaho' },
        { '@type': 'City', name: 'Meridian, Idaho' },
        { '@type': 'City', name: 'Boise, Idaho' },
        { '@type': 'City', name: 'Eagle, Idaho' },
        { '@type': 'City', name: 'Nampa, Idaho' },
        { '@type': 'City', name: 'Kuna, Idaho' },
        { '@type': 'City', name: 'Star, Idaho' },
      ],
      knowsAbout: [
        'Small business website design',
        'Website development',
        'Technical SEO',
        'Local search visibility',
        'Google Business Profile',
        'Google Search Console',
        'Website analytics',
        'Domain and DNS management',
        'Website performance',
        'Ongoing website management',
      ],
      founder: {
        '@id': 'https://brightersites.app/#isaac-bright',
      },
    },
    {
      '@type': 'Person',
      '@id': 'https://brightersites.app/#isaac-bright',
      name: 'Isaac Bright',
      url: 'https://brightersites.app/about/',
      jobTitle: 'Founder, Designer, and Developer',
      worksFor: {
        '@id': 'https://brightersites.app/#organization',
      },
      sameAs: [
        'https://www.linkedin.com/in/isaac-bright-9b8051433/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://brightersites.app/#website',
      url: 'https://brightersites.app/',
      name: 'Brighter Sites',
      publisher: {
        '@id': 'https://brightersites.app/#organization',
      },
    },
  ],
};

const analyticsConfig = JSON.stringify({
  collectorUrl: 'https://analytics.brightersites.app',
  siteKey: 'bs_live_495e5683c0b08bdfb1c856aff92f9abcb2f2cd8ee0b09a24',
  scriptVersion: '2.2.0',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Brighter Sites" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Brighter Sites" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Brighter Sites" />

    <meta name="theme-color" content="#102b32" />
    <link rel="icon" type="image/png" href="/images/branding/brighter-sites-favicon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    {
      showConsultationCta && (
        <section class="section">
          <div class="container">
            <div class="cta-panel">
              <p class="eyebrow">Free 15-minute website consultation</p>
              <h2>Have questions before you get started?</h2>
              <p>
                Talk through your current website, what your business needs, and
                whether Brighter Sites is a good fit. Consultations are held
                online through Google Meet, with no pressure or obligation.
              </p>
              <a class="button secondary" href="/contact/#consultation">
                Request a free 15-minute consultation
              </a>
            </div>
          </div>
        </section>
      )
    }

    <Footer />

  <script
    is:inline
    type="application/json"
    data-bs-analytics-config
    set:html={analyticsConfig}
  ></script>
  <script
    is:inline
    src="/brighter-analytics.js?v=2.2.0"
    defer
  ></script>
</body>
</html>
