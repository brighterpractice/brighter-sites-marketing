---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Start a Therapist Website Project | Brighter Sites"
  description="Start a conversation with Brighter Sites about a custom website for your therapy practice."
>
  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">Start a project</p>
      <h1>Tell us what you want your website to become.</h1>
      <p class="page-lead">
        Whether you are opening a new practice or replacing an existing site, the first step is simply a conversation.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2>Start with a simple introduction.</h2>
        <p>
          Tell us about your practice, where you are located, and what you would like your website to accomplish.
        </p>
      </div>

      <div class="contact-card">
        <p>Email</p>
        <a href="mailto:help@brightersites.app">
          help@brightersites.app
        </a>

        <p style="margin-top:1.25rem">
          Send a short introduction with your practice name, location, and what
          you are hoping to improve or build. We will reply with the next steps
          and any questions needed to understand the project.
        </p>

        <a class="button" href="mailto:help@brightersites.app">
          Start a conversation
        </a>
      </div>
    </div>
  </section>
</Layout>
