---
import Layout from '../../layouts/Layout.astro';

const externalResources = [
  {
    eyebrow: 'Search visibility',
    title: 'Google Search Console',
    description:
      'See how Google Search is interacting with your site, including search impressions, clicks, queries, indexed pages, and technical search issues.',
    note:
      'Best for understanding search visibility and indexing. It does not guarantee rankings or explain every change automatically.',
    href: 'https://search.google.com/search-console/about',
    linkLabel: 'Open Google Search Console',
  },
  {
    eyebrow: 'Performance',
    title: 'PageSpeed Insights',
    description:
      'Review mobile and desktop performance signals and see where page-loading or user-experience issues may deserve attention.',
    note:
      'Useful for technical performance. A strong score does not by itself mean the site is effective at attracting or converting customers.',
    href: 'https://pagespeed.web.dev/',
    linkLabel: 'Open PageSpeed Insights',
  },
  {
    eyebrow: 'Local presence',
    title: 'Google Business Profile',
    description:
      'Manage the public business information that can appear across Google Search and Maps, including services, hours, photos, reviews, and website links.',
    note:
      'For local businesses, the profile should reinforce the same real-world business identity and service information shown on the website.',
    href: 'https://www.google.com/business/',
    linkLabel: 'Open Google Business Profile',
  },
  {
    eyebrow: 'Structured data',
    title: 'Google Rich Results Test',
    description:
      'Check whether Google can detect supported structured data on a page and whether the markup has technical problems.',
    note:
      'Structured data can help search systems understand eligible information, but passing the test does not guarantee a special search-result treatment.',
    href: 'https://search.google.com/test/rich-results',
    linkLabel: 'Open Rich Results Test',
  },
  {
    eyebrow: 'Domain ownership',
    title: 'ICANN Lookup',
    description:
      'Look up public registration information associated with a domain and confirm which registrar is responsible for it.',
    note:
      'Helpful when you are trying to understand who manages a domain. Public registration data may be limited by privacy protections.',
    href: 'https://lookup.icann.org/en',
    linkLabel: 'Open ICANN Lookup',
  },
  {
    eyebrow: 'Accessibility',
    title: 'WAVE Web Accessibility Evaluation Tool',
    description:
      'Run an automated accessibility review that can surface certain structural, contrast, labeling, and content issues worth investigating.',
    note:
      'Automated checks are useful indicators, not a complete accessibility audit. Human review still matters.',
    href: 'https://wave.webaim.org/',
    linkLabel: 'Open WAVE',
  },
];

const reviewQuestions = [
  'Do you know who owns and controls your domain account?',
  'Do you know whether your important pages are actually indexed by Google?',
  'Can you see which searches are creating impressions for your website?',
  'Do you know how your site performs on both mobile and desktop?',
  'Does your Google Business Profile match the services and information on your website?',
  'Can you tell where visitors came from and whether they reached a contact or consultation path?',
  'Do you have someone responsible for reviewing these systems after the website launches?',
];
---

<Layout
  title="Small Business Website Resources | Brighter Sites"
  description="Useful website, Google, domain, performance, accessibility, and analytics resources for small-business owners—plus plain-English guidance on what each tool can tell you."
  hideConsultationCta={true}
>
  <section class="page-intro resources-intro">
    <div class="container resources-intro-grid">
      <div>
        <p class="eyebrow">Brighter Sites Resources</p>
        <h1>Useful tools and references for understanding your online presence.</h1>
      </div>

      <div class="resources-lead">
        <p>
          These resources are not meant to turn you into your own web department.
          They give you direct access to the systems and public tools that can
          reveal important information about your website, search visibility,
          domain, performance, accessibility, and local presence.
        </p>
        <p>
          If you want to understand why these systems matter before you start
          working in them, the Brighter Sites Guides explain the concepts in
          plain English without becoming step-by-step DIY tutorials.
        </p>
        <a class="text-link" href="/guides/">Browse Brighter Sites Guides →</a>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="container resources-purpose-grid">
      <div>
        <p class="eyebrow">Resources vs. guides</p>
        <h2>Use the guides to understand. Use the resources to inspect.</h2>
      </div>

      <div class="resources-purpose-copy">
        <p>
          The Guides section explains ideas such as crawling, indexing, SEO,
          website architecture, analytics, domains, and the tradeoffs between
          DIY and managed website work.
        </p>
        <p>
          This page is different. It is a practical directory of useful tools
          and checkpoints so you can see what the major systems are reporting
          about your business online.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading resources-heading">
        <p class="eyebrow">Public tools worth knowing about</p>
        <h2>See what the major systems are telling you.</h2>
        <p>
          Each tool answers a different question. No single score or dashboard
          tells you whether a website is healthy, visible, trustworthy, and
          effective as a whole.
        </p>
      </div>

      <div class="resource-tool-grid">
        {
          externalResources.map((resource) => (
            <article class="resource-tool-card">
              <p class="resource-tool-eyebrow">{resource.eyebrow}</p>
              <h3>{resource.title}</h3>
              <p>{resource.description}</p>
              <p class="resource-tool-note">{resource.note}</p>
              <a
                class="text-link"
                href={resource.href}
                target="_blank"
                rel="noopener noreferrer"
                data-track={`resource_${resource.title
                  .toLowerCase()
                  .replaceAll(/[^a-z0-9]+/g, '_')}`}
              >
                {resource.linkLabel} ↗
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section resources-check-section">
    <div class="container resources-check-grid">
      <div>
        <p class="eyebrow">A quick business-owner check</p>
        <h2>Can you answer these questions about your website today?</h2>
        <p class="resources-check-lead">
          You do not need to know every technical detail. But these are useful
          questions for understanding whether the web side of the business is
          actually being managed.
        </p>
      </div>

      <div class="resources-question-list">
        {reviewQuestions.map((question) => (
          <div class="resources-question">
            <span aria-hidden="true">✓</span>
            <p>{question}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="container resource-help-grid">
      <article class="resource-help-card">
        <p class="eyebrow">Complimentary website review</p>
        <h2>Want another set of eyes on your current site?</h2>
        <p>
          Send Brighter Sites your website address and ask for a complimentary
          review. I can look at the visible structure, mobile experience, search
          basics, performance signals, and obvious issues and tell you what
          stands out.
        </p>
        <p class="resource-help-note">
          If the site is in good shape, I will tell you that too. The review is
          meant to give you useful context, not manufacture problems to sell work.
        </p>
        <a class="button" href="/contact/" data-track="resource_request_review">
          Ask for a website review
        </a>
      </article>

      <article class="resource-help-card resource-help-card--dark">
        <p class="eyebrow">Free 15-minute consultation</p>
        <h2>Know what you want to understand, but not what to do next?</h2>
        <p>
          We can talk through the website, search, domain, analytics, or local
          presence question you are dealing with and decide whether it makes
          sense to handle it yourself or have Brighter Sites take care of it.
        </p>
        <p class="resource-help-note">
          No pressure and no obligation. The goal is to help you understand the
          decision before you spend money or several hours learning another system.
        </p>
        <a
          class="button secondary resource-light-button"
          href="/contact/#consultation"
          data-track="resource_consultation"
        >
          Request a free consultation
        </a>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container resources-time-panel">
      <p class="eyebrow">The time-cost question</p>
      <h2>Free tools are not always free work.</h2>
      <p>
        Search Console, PageSpeed Insights, Business Profile tools, domain lookup,
        and other resources may not charge you to open them. The cost can show up
        in the hours required to learn what the reports mean, decide what matters,
        troubleshoot problems, make changes, and check whether those changes worked.
      </p>
      <p>
        Sometimes doing that yourself is absolutely the right choice. Other times,
        paying someone who already understands the systems gives you those hours
        back for client work, sales, operations, leadership, or whatever only you
        can do inside your business.
      </p>
      <div class="resources-time-actions">
        <a class="text-link" href="/guides/wix-vs-custom-website/">
          Read about the DIY time tradeoff →
        </a>
        <a class="text-link" href="/services/">
          See Brighter Sites services →
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .resources-intro-grid,
  .resources-purpose-grid,
  .resources-check-grid {
    display: grid;
    gap: 2rem;
  }

  .resources-intro h1 {
    max-width: 14ch;
  }

  .resources-lead,
  .resources-purpose-copy {
    max-width: 47rem;
  }

  .resources-lead p + p,
  .resources-purpose-copy p + p,
  .resources-time-panel p + p {
    margin-top: 1rem;
  }

  .resources-lead .text-link {
    display: inline-block;
    margin-top: 1.2rem;
  }

  .resources-heading {
    max-width: 54rem;
  }

  .resource-tool-grid {
    display: grid;
    gap: 1rem;
  }

  .resource-tool-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: white;
    box-shadow: var(--shadow-soft);
  }

  .resource-tool-card h3 {
    margin-bottom: .7rem;
  }

  .resource-tool-card > p:not(.resource-tool-eyebrow):not(.resource-tool-note) {
    margin-bottom: .9rem;
  }

  .resource-tool-eyebrow {
    margin-bottom: .55rem;
    color: var(--teal-dark);
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .resource-tool-note {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: .88rem;
  }

  .resource-tool-card .text-link {
    width: fit-content;
    margin-top: 1rem;
  }

  .resources-check-section {
    background: var(--ink);
    color: #d6e4e1;
  }

  .resources-check-section h2 {
    color: white;
  }

  .resources-check-section .eyebrow {
    color: #9fd1c8;
  }

  .resources-check-lead {
    max-width: 38rem;
    margin-top: 1rem;
  }

  .resources-question-list {
    display: grid;
    gap: .75rem;
  }

  .resources-question {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: .8rem;
    align-items: start;
    padding: 1rem;
    border: 1px solid rgba(255,255,255,.11);
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,.05);
  }

  .resources-question span {
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border-radius: 50%;
    background: rgba(159,209,200,.14);
    color: #9fd1c8;
    font-weight: 850;
  }

  .resource-help-grid {
    display: grid;
    gap: 1rem;
  }

  .resource-help-card {
    padding: clamp(1.6rem, 4vw, 2.4rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: white;
    box-shadow: var(--shadow-soft);
  }

  .resource-help-card h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .resource-help-card > p:not(.eyebrow) {
    margin-top: 1rem;
  }

  .resource-help-note {
    color: var(--ink-soft);
    font-size: .9rem;
  }

  .resource-help-card .button {
    margin-top: 1.5rem;
  }

  .resource-help-card--dark {
    border-color: transparent;
    background: var(--ink);
    color: #d6e4e1;
  }

  .resource-help-card--dark h2 {
    color: white;
  }

  .resource-help-card--dark .eyebrow {
    color: #9fd1c8;
  }

  .resource-help-card--dark .resource-help-note {
    color: #a9c0bb;
  }

  .resource-light-button {
    border-color: white !important;
    color: white !important;
  }

  .resource-light-button:hover {
    background: white !important;
    color: var(--ink) !important;
  }

  .resources-time-panel {
    max-width: 58rem;
    padding: clamp(1.75rem, 5vw, 3rem);
    border: 1px solid rgba(39,119,111,.28);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgba(216,235,230,.42), white 70%);
    box-shadow: var(--shadow-soft);
  }

  .resources-time-panel h2 {
    max-width: 18ch;
  }

  .resources-time-panel > p:not(.eyebrow) {
    max-width: 48rem;
    margin-top: 1rem;
  }

  .resources-time-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 1.4rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 48rem) {
    .resources-intro-grid,
    .resources-purpose-grid,
    .resources-check-grid {
      grid-template-columns: .9fr 1.1fr;
      align-items: start;
    }

    .resource-tool-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .resource-help-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 70rem) {
    .resource-tool-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
