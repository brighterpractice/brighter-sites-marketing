---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Custom websites built for therapists</p>

        <h1>
          A professional website should make your practice feel
          <span>easy to trust.</span>
        </h1>

        <p class="hero-lead">
          Brighter Sites designs and builds your website around your actual
          practice, handles the technical launch, and can keep managing the
          web side of the business after you go live.
        </p>

        <div class="hero-actions">
          <a class="button" href="/contact/">Start your website</a>
          <a class="button secondary" href="/work/">View our work</a>
        </div>
      </div>

      <div class="showcase-wrap" aria-label="Example therapy website">
        <div class="showcase-glow"></div>

        <div class="browser">
          <div class="browser-bar">
            <span class="browser-dot"></span>
            <span class="browser-dot"></span>
            <span class="browser-dot"></span>
            <span class="browser-address"></span>
          </div>

          <div class="demo-site">
            <div class="demo-nav">
              <span class="demo-logo"></span>
              <span class="demo-brand">Evergreen Counseling Collective</span>
            </div>

            <div class="demo-content">
              <div>
                <h3>A place to feel understood.</h3>
                <p>
                  Thoughtful individual therapy presented with clarity,
                  warmth, and professionalism.
                </p>
                <span class="demo-button">Request appointment</span>
              </div>

              <div class="demo-art"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="confidence-strip" aria-label="What working with Brighter Sites includes">
    <div class="container confidence-grid">
      <div>
        <strong>Custom from the start</strong>
        <span>Designed around your practice—not a prebuilt therapy template.</span>
      </div>
      <div>
        <strong>The technical work is handled</strong>
        <span>Mobile, domain, launch, search setup, and the details behind the site.</span>
      </div>
      <div>
        <strong>Support stays optional</strong>
        <span>Keep managing with us after launch, or transition the site under your agreement.</span>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Built around your practice</p>

        <h2>More than a good-looking website.</h2>

        <p>
          Your site should help potential clients understand your practice,
          feel comfortable with your approach, and know exactly what to do
          next.
        </p>
        <p style="margin-top:1.5rem">
          <a class="text-link" href="/services/">Explore all services →</a>
        </p>
      </div>

      <div class="feature-grid">
        <article class="feature">
          <h3>Custom design</h3>
          <p>
            A site designed around your practice rather than forcing your
            content into a generic template.
          </p>
        </article>

        <article class="feature">
          <h3>Built for every screen</h3>
          <p>
            Professional presentation and straightforward navigation on
            phones, tablets, laptops, and desktops.
          </p>
        </article>

        <article class="feature">
          <h3>Made for therapy practices</h3>
          <p>
            Clinician profiles, service pages, appointment paths, privacy
            considerations, and practice information presented clearly.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2>Calm, credible, and unmistakably professional.</h2>
      </div>

      <article class="work-card">
        <div>
          <p class="eyebrow">Four live demonstrations</p>
          <h3>Different practices. Different personalities. Different websites.</h3>

          <p>
            Explore four complete therapy-practice websites ranging from calm
            and organic to modern, expressive, and cinematic. Each demonstrates
            a different custom design direction rather than variations of one
            template.
          </p>

          <p style="margin-top:1.5rem">
            <a class="text-link" href="/work/">Explore all four live demos →</a>
          </p>
        </div>

        <div class="work-preview">
          <div class="work-preview-inner"></div>
        </div>
      </article>
    </div>
  </section>

  <section class="section tint">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">A simple process</p>
        <h2>You focus on your practice. We build the site.</h2>
      </div>

      <p style="margin-bottom:2rem">
        <a class="text-link" href="/process/">See how the process works →</a>
      </p>

      <div class="process-grid">
        <div class="process-step">
          <span>01</span>
          <h3>Learn</h3>
          <p>
            We learn about your practice, your clients, the services you
            provide, and what you want your website to communicate.
          </p>
        </div>

        <div class="process-step">
          <span>02</span>
          <h3>Design</h3>
          <p>
            We build the structure, visual system, pages, and mobile experience
            around your practice.
          </p>
        </div>

        <div class="process-step">
          <span>03</span>
          <h3>Refine</h3>
          <p>
            You review the site and we make adjustments until the presentation
            feels right.
          </p>
        </div>

        <div class="process-step">
          <span>04</span>
          <h3>Launch</h3>
          <p>
            We take care of the technical launch so your new site is ready for
            clients.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Why Brighter Sites</p>

        <h2>A website builder gives you tools. We handle the web work.</h2>

        <p>
          DIY platforms such as Wix can be useful when you want to build and
          manage a website yourself. But the software does not decide how your
          practice should be presented, organize the client journey, test the
          mobile experience, interpret analytics, watch search visibility, or
          decide what should improve next.
        </p>

        <p style="margin-top:1rem">
          Brighter Sites is for practice owners who want a custom website
          without becoming the person responsible for design, technical setup,
          SEO, analytics, and ongoing website maintenance.
        </p>

        <p style="margin-top:1.5rem">
          <a class="text-link" href="/website-strategy/">Why the strategy behind the site matters →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section founding-section">
    <div class="container founding-panel">
      <div>
        <p class="eyebrow">Founding Practice Program · First 5 practices</p>
        <h2>Help us launch. Get more value at launch.</h2>
        <p>
          Our first five qualifying practice clients receive a Professional
          Website starting at <strong>$1,250</strong> instead of $1,500, plus
          the first <strong>90 days of Managed Growth</strong> at no additional
          cost after the site launches.
        </p>
      </div>

      <div class="founding-benefits">
        <div>
          <strong>$250 introductory savings</strong>
          <span>On the standard Professional Website starting price.</span>
        </div>
        <div>
          <strong>3 monthly performance reports</strong>
          <span>Findings, trends, priorities, and recommended improvements.</span>
        </div>
        <div>
          <strong>No obligation after 90 days</strong>
          <span>Continue Managed Growth, choose another care level, or stop ongoing service.</span>
        </div>
        <a class="button" href="/services/">See founding offer details</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-panel">
        <p class="eyebrow">Ready when you are</p>

        <h2>Give your practice a website you are proud to send people to.</h2>

        <p>
          Tell us about your practice, what you are building or improving, and
          what you want the website to help you accomplish.
        </p>

        <a class="button" href="mailto:help@brightersites.app">
          Start a conversation
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .confidence-strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: white;
  }

  .confidence-grid {
    display: grid;
  }

  .confidence-grid > div {
    display: grid;
    gap: .3rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }

  .confidence-grid > div:last-child {
    border-bottom: 0;
  }

  .confidence-grid strong {
    color: var(--ink);
    font-size: .92rem;
  }

  .confidence-grid span {
    max-width: 25rem;
    color: var(--body);
    font-size: .82rem;
    line-height: 1.5;
  }

  .founding-section {
    padding-top: 0;
  }

  .founding-panel {
    display: grid;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid rgba(39,119,111,.28);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 90% 10%, rgba(95,174,163,.22), transparent 28%),
      linear-gradient(135deg, #f7f3ea, white);
  }

  .founding-panel h2 {
    max-width: 15ch;
  }

  .founding-panel > div:first-child > p:not(.eyebrow) {
    max-width: 44rem;
    margin-top: 1rem;
  }

  .founding-benefits {
    display: grid;
    gap: 1rem;
  }

  .founding-benefits > div {
    display: grid;
    gap: .25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .founding-benefits strong {
    color: var(--ink);
  }

  .founding-benefits span {
    color: var(--body);
    font-size: .88rem;
    line-height: 1.5;
  }

  .founding-benefits .button {
    width: fit-content;
    margin-top: .5rem;
  }

  @media (min-width: 48rem) {
    .confidence-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .confidence-grid > div {
      min-height: 7rem;
      padding: 1.4rem 1.8rem;
      border-right: 1px solid var(--line);
      border-bottom: 0;
    }

    .confidence-grid > div:first-child {
      padding-left: 0;
    }

    .confidence-grid > div:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }

  @media (min-width: 58rem) {
    .founding-panel {
      grid-template-columns: 1fr .9fr;
      align-items: start;
    }
  }
</style>