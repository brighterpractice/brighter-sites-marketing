---
import Layout from '../../layouts/Layout.astro';
import WorkValueCase from '../../components/WorkValueCase.astro';

const liveSites = [
  {
    name: 'Bright Hope Therapy',
    location: 'Meridian, Idaho',
    description:
      'A warm, professional counseling website created for an independent therapy practice in Meridian, Idaho.',
    details:
      'Designed with a mobile-first experience, clear service navigation, local search visibility, and an easy path for prospective clients to learn about the practice.',
    tags: ['Mobile-first', 'Local search', 'Client-friendly'],
    href: 'https://brighthopetherapyllc.com',
  },
];

const demos = [
  {
    name: 'Signal & Structure Coaching',
    scope: 'Specialty custom coaching site',
    pages: '11 primary pages',
    description:
      'An energetic ADHD and executive-function coaching website built around a dark navigation rail, bright signal accents, modular layouts, and a systems-focused brand.',
    tags: ['Energetic', 'Structured', 'Modern'],
    href: 'https://signal-structure.brightersites.app',
    preview: 'signal',
  },
  {
    name: 'Evergreen Counseling Collective',
    scope: 'Focused custom practice site',
    pages: '7 primary pages',
    description:
      'A warm, grounded seven-page custom counseling website built around soft greens, organic imagery, calm typography, and straightforward client navigation.',
    tags: ['Warm', 'Organic', 'Grounded'],
    href: 'https://evergreen.brightersites.app',
    preview: 'evergreen',
  },
  {
    name: 'Align Therapy Group',
    scope: 'Expanded custom practice site',
    pages: '12 primary pages',
    description:
      'A more developed 12-page custom counseling website with structured layouts, clean blue tones, dedicated service content, and a polished group-practice feel.',
    tags: ['Modern', 'Structured', 'Contemporary'],
    href: 'https://align.brightersites.app',
    preview: 'align',
  },
  {
    name: 'Common Ground Therapy',
    scope: 'Comprehensive custom practice site',
    pages: '19 primary pages',
    description:
      'A larger custom therapy website using richer color, editorial layouts, deeper service and approach content, and a warmer visual energy.',
    tags: ['Expressive', 'Warm', 'Distinctive'],
    href: 'https://common.brightersites.app',
    preview: 'common',
  },
  {
    name: 'Horizon Therapy',
    scope: 'Comprehensive custom practice site',
    pages: '20 primary pages',
    description:
      'An immersive, full-scale custom counseling website built around expansive Montana imagery, cinematic presentation, deeper content, and a strong sense of place.',
    tags: ['Immersive', 'Scenic', 'Cinematic'],
    href: 'https://horizon.brightersites.app',
    preview: 'horizon',
  },
];
---

<Layout
  title="Example Sites | Brighter Sites"
  description="Visit a live Brighter Sites client website and explore five custom therapy and coaching website design examples."
>
  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">Example sites</p>
      <h1>Different practices deserve different websites.</h1>
      <p class="page-lead">
        Start with a website built for a real counseling practice, then explore
        five fully navigable design demonstrations for therapy and coaching
        practices. Each site has its own visual direction, practice personality,
        content voice, and client experience.
      </p>
      <p class="scope-note">
        Live client sites are clearly identified. The demonstration sites are
        complete, custom-built examples—not paid client projects.
      </p>
    </div>
  </section>

  <section class="section live-sites-section">
    <div class="container">
      <div class="collection-heading">
        <p class="eyebrow">Live client sites</p>
        <h2>Built for a real practice and serving real visitors.</h2>
        <p>
          These websites are launched, active, and supporting the day-to-day
          work of independent practices.
        </p>
      </div>

      {
        liveSites.map((liveSite) => (
          <article class="portfolio-feature portfolio-feature--live">
            <div class="portfolio-copy">
              <span class="live-site-badge">Live site</span>

              <div class="scope-row" aria-label={`Site type: Live client website, ${liveSite.location}`}>
                <span class="scope-badge">Live client website</span>
                <span class="scope-pages">{liveSite.location}</span>
              </div>

              <h3 class="portfolio-title">{liveSite.name}</h3>

              <p>{liveSite.description}</p>
              <p>{liveSite.details}</p>

              <div class="tag-row">
                {liveSite.tags.map((tag) => <span>{tag}</span>)}
              </div>

              <a
                class="button"
                href={liveSite.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                Visit live site →
              </a>
            </div>

            <a
              class="portfolio-preview portfolio-preview--bright-hope"
              href={liveSite.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit ${liveSite.name} live website`}
            >
              <div class="preview-window" aria-hidden="true">
                <div class="preview-top">
                  <span></span><span></span><span></span>
                  <i></i>
                </div>

                <div class="site-mini bright-hope-mini">
                  <div class="mini-nav bright-hope-nav">
                    <div class="bright-hope-brand">
                      <span class="bright-hope-mark"></span>
                      <b>Bright Hope <small>THERAPY</small></b>
                    </div>
                    <div class="mini-links"><span></span><span></span><span></span></div>
                  </div>
                  <div class="bright-hope-hero">
                    <div class="bright-hope-copy">
                      <small>MERIDIAN + STATEWIDE IDAHO TELEHEALTH</small>
                      <strong>Compassionate support for the parts of life that feel difficult to carry alone.</strong>
                      <p>Individual counseling for adults, in person and by telehealth.</p>
                      <em>Request appointment</em>
                    </div>
                    <div class="bright-hope-portrait">
                      <span class="portrait-head"></span>
                      <span class="portrait-body"></span>
                    </div>
                  </div>
                  <div class="bright-hope-status">CURRENTLY WAITLISTING NEW CLIENTS</div>
                </div>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section demo-sites-section">
    <div class="container">
      <div class="collection-heading">
        <p class="eyebrow">Design examples</p>
        <h2>Five complete demos. Five different directions.</h2>
        <p>
          Page counts show the relative scope and content depth of each example;
          privacy, terms, and other utility pages are not included.
        </p>
      </div>

      <div class="demo-list">
      {
        demos.map((demo) => (
          <article class="portfolio-feature">
            <div class="portfolio-copy">
              <p class="eyebrow">Demo design</p>

              <div class="scope-row" aria-label={`Site scope: ${demo.scope}, ${demo.pages}`}>
                <span class="scope-badge">{demo.scope}</span>
                <span class="scope-pages">{demo.pages}</span>
              </div>

              <h3 class="portfolio-title">{demo.name}</h3>

              <p>{demo.description}</p>

              <div class="tag-row">
                {demo.tags.map((tag) => <span>{tag}</span>)}
              </div>

              <a
                class="button"
                href={demo.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                Explore demo site →
              </a>
            </div>

            <a
              class={`portfolio-preview portfolio-preview--${demo.preview}`}
              href={demo.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Explore ${demo.name} demo website`}
            >
              <div class="preview-window" aria-hidden="true">
                <div class="preview-top">
                  <span></span><span></span><span></span>
                  <i></i>
                </div>

                {demo.preview === 'signal' && (
                  <div class="site-mini signal-mini">
                    <div class="signal-shell">
                      <div class="signal-rail">
                        <div class="signal-brand">
                          SIGNAL &amp;<br />STRUCTURE
                          <small>COACHING</small>
                        </div>
                        <span></span>
                        <span></span>
                        <span></span>
                        <em>DISCOVERY CALL</em>
                      </div>

                      <div class="signal-copy">
                        <small>ADHD &amp; EXECUTIVE FUNCTION COACHING</small>
                        <strong>Build systems that work with your brain.</strong>
                        <p>Practical structure for planning, focus, and follow-through.</p>
                        <b>BOOK A DISCOVERY CALL</b>
                        <div class="signal-blocks">
                          <span></span>
                          <span></span>
                          <span></span>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {demo.preview === 'evergreen' && (
                  <div class="site-mini evergreen-mini">
                    <div class="mini-nav evergreen-nav">
                      <div class="mini-brand">
                        <span class="evergreen-mark"></span>
                        <b>Evergreen</b>
                      </div>
                      <div class="mini-links"><span></span><span></span><span></span></div>
                    </div>
                    <div class="evergreen-hero">
                      <div class="mini-copy">
                        <small>COUNSELING COLLECTIVE</small>
                        <strong>A quieter place to sort through what feels tangled.</strong>
                        <p>Individual counseling with room to slow down and reconnect.</p>
                        <em>Request appointment</em>
                      </div>
                      <div class="evergreen-art">
                        <span class="leaf leaf-one"></span>
                        <span class="leaf leaf-two"></span>
                        <span class="leaf leaf-three"></span>
                      </div>
                    </div>
                    <div class="evergreen-footer-line"><span></span><span></span><span></span></div>
                  </div>
                )}

                {demo.preview === 'align' && (
                  <div class="site-mini align-mini">
                    <div class="mini-nav align-nav">
                      <div class="align-logo">ALIGN<span>•</span></div>
                      <div class="mini-links"><span></span><span></span><span></span></div>
                    </div>
                    <div class="align-hero">
                      <div class="align-copy">
                        <small>THERAPY GROUP</small>
                        <strong>When your inner life and outer life no longer match.</strong>
                        <p>Focused counseling for adults who want to understand what keeps repeating.</p>
                        <em>Meet Jordan</em>
                      </div>
                      <div class="align-art">
                        <span class="align-orbit orbit-one"></span>
                        <span class="align-orbit orbit-two"></span>
                        <span class="align-core"></span>
                      </div>
                    </div>
                    <div class="align-stats"><span>NOTICE</span><span>UNDERSTAND</span><span>CHOOSE</span></div>
                  </div>
                )}

                {demo.preview === 'common' && (
                  <div class="site-mini common-mini">
                    <div class="common-topline">
                      <b>COMMON GROUND</b>
                      <span>THERAPY</span>
                    </div>
                    <div class="common-editorial">
                      <div class="common-copy">
                        <small>RICHMOND, VIRGINIA</small>
                        <strong>Therapy for real life, real people.</strong>
                        <p>A warm, down-to-earth place to bring what feels heavy or confusing.</p>
                        <em>Start where you are →</em>
                      </div>
                      <div class="common-art">
                        <span class="common-sun"></span>
                        <span class="common-arch"></span>
                        <span class="common-line line-one"></span>
                        <span class="common-line line-two"></span>
                      </div>
                    </div>
                    <div class="common-quote">BRING THE MESSY VERSION • START WHERE YOU ARE</div>
                  </div>
                )}

                {demo.preview === 'horizon' && (
                  <div class="site-mini horizon-mini">
                    <div class="horizon-sky">
                      <div class="mini-nav horizon-nav">
                        <b>HORIZON</b>
                        <div class="mini-links"><span></span><span></span><span></span></div>
                      </div>
                      <span class="horizon-sun"></span>
                      <span class="mountain mountain-back"></span>
                      <span class="mountain mountain-mid"></span>
                      <span class="mountain mountain-front"></span>
                      <div class="horizon-copy">
                        <small>BOZEMAN, MONTANA</small>
                        <strong>Therapy for where you are now—and where you want to go.</strong>
                        <em>Explore services</em>
                      </div>
                    </div>
                    <div class="horizon-bottom"><span>A WIDER VIEW</span><span>CLEARER DIRECTION</span></div>
                  </div>
                )}
              </div>
            </a>
          </article>
        ))
      }
      </div>
    </div>
  </section>

  <WorkValueCase />
</Layout>

<style>
  .scope-note {
    max-width: 43rem;
    margin-top: 1rem;
    color: var(--body);
    font-size: .86rem;
  }

  .collection-heading {
    max-width: 47rem;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .collection-heading h2 {
    max-width: 22ch;
  }

  .collection-heading > p:last-child {
    max-width: 42rem;
    margin-top: 1rem;
    color: var(--ink-soft);
  }

  .demo-sites-section {
    background: var(--cream);
  }

  .demo-list {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .portfolio-feature {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: white;
    box-shadow: var(--shadow-soft);
  }

  .portfolio-feature--live {
    border-color: rgba(39,119,111,.42);
    box-shadow: 0 24px 60px rgba(16,43,50,.12);
  }

  .portfolio-copy {
    padding: clamp(2rem, 5vw, 4rem);
    color: var(--body);
  }

  .portfolio-title {
    margin-top: .85rem;
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 3.15rem);
    font-weight: 500;
    line-height: 1.06;
  }

  .portfolio-copy > p:not(.eyebrow) {
    max-width: 38rem;
    margin-top: 1.2rem;
    color: var(--ink-soft);
  }

  .portfolio-copy .eyebrow {
    color: var(--teal-dark);
  }

  .live-site-badge {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .42rem .72rem;
    border-radius: 999px;
    background: var(--teal-dark);
    color: white;
    font-size: .68rem;
    font-weight: 850;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .live-site-badge::before {
    width: .48rem;
    height: .48rem;
    border-radius: 50%;
    background: #aee7bf;
    box-shadow: 0 0 0 .22rem rgba(174,231,191,.18);
    content: '';
  }

  .scope-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .55rem .75rem;
    margin-top: .85rem;
  }

  .scope-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: .35rem .7rem;
    border: 1px solid rgba(39,119,111,.22);
    border-radius: 999px;
    background: var(--teal-light);
    color: var(--teal-dark);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .02em;
  }

  .scope-pages {
    color: var(--body);
    font-size: .78rem;
    font-weight: 750;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin: 1.5rem 0 1.8rem;
  }

  .tag-row span {
    padding: .38rem .7rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink-soft);
    font-size: .75rem;
    font-weight: 750;
  }

  .portfolio-preview {
    display: block;
    min-height: 22rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    text-decoration: none;
  }

  .preview-window {
    height: 100%;
    min-height: 19rem;
    overflow: hidden;
    border: 1px solid rgba(16,43,50,.09);
    border-radius: 1rem;
    background: white;
    box-shadow: 0 18px 45px rgba(16,43,50,.16);
    transition: transform .22s ease, box-shadow .22s ease;
  }

  .portfolio-preview:hover .preview-window {
    transform: translateY(-3px) scale(1.008);
    box-shadow: 0 24px 55px rgba(16,43,50,.2);
  }

  .preview-top {
    display: flex;
    height: 2.3rem;
    align-items: center;
    gap: .35rem;
    padding: 0 .8rem;
    border-bottom: 1px solid rgba(16,43,50,.08);
    background: rgba(255,255,255,.9);
  }

  .preview-top > span {
    width: .48rem;
    height: .48rem;
    border-radius: 50%;
    background: #cbd6d2;
  }

  .preview-top i {
    width: 45%;
    height: .55rem;
    margin-left: .5rem;
    border-radius: 999px;
    background: #e8eeeb;
  }

  .site-mini {
    min-height: 17rem;
    overflow: hidden;
    font-family: Arial, sans-serif;
  }

  .mini-nav {
    display: flex;
    min-height: 2.7rem;
    align-items: center;
    justify-content: space-between;
    padding: .6rem 1rem;
  }

  .mini-links {
    display: flex;
    gap: .38rem;
  }

  .mini-links span {
    display: block;
    width: 1.5rem;
    height: .16rem;
    border-radius: 999px;
    background: currentColor;
    opacity: .35;
  }

  .mini-copy small,
  .align-copy small,
  .common-copy small,
  .horizon-copy small {
    display: block;
    font-size: .43rem;
    font-weight: 800;
    letter-spacing: .14em;
  }

  .mini-copy strong,
  .align-copy strong,
  .common-copy strong,
  .horizon-copy strong {
    display: block;
    font-family: Georgia, serif;
    font-weight: 400;
    line-height: 1.02;
  }

  .mini-copy p,
  .align-copy p,
  .common-copy p {
    max-width: 13rem;
    margin: .6rem 0 0;
    font-size: .56rem;
    line-height: 1.55;
  }

  .mini-copy em,
  .align-copy em,
  .common-copy em,
  .horizon-copy em,
  .bright-hope-copy em {
    display: inline-block;
    margin-top: .8rem;
    padding: .42rem .7rem;
    border-radius: 999px;
    font-size: .48rem;
    font-style: normal;
    font-weight: 700;
  }

  /* Bright Hope Therapy: live counseling-practice website. */
  .portfolio-preview--bright-hope {
    background:
      radial-gradient(circle at 85% 10%, rgba(255,255,255,.62), transparent 28%),
      linear-gradient(135deg, #e9e3d7, #70877d);
  }

  .bright-hope-mini {
    background: #fffdf9;
    color: #24332f;
  }

  .bright-hope-nav {
    border-bottom: 1px solid rgba(112,135,125,.2);
    background: rgba(255,253,249,.96);
  }

  .bright-hope-brand {
    display: flex;
    align-items: center;
    gap: .45rem;
    font-family: Georgia, serif;
  }

  .bright-hope-brand b {
    font-size: .62rem;
    font-weight: 500;
    line-height: .9;
  }

  .bright-hope-brand small {
    display: block;
    margin-top: .2rem;
    color: #8a5236;
    font-family: Arial, sans-serif;
    font-size: .28rem;
    font-weight: 800;
    letter-spacing: .15em;
  }

  .bright-hope-mark {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    border: .12rem solid #70877d;
    border-radius: 50%;
  }

  .bright-hope-mark::before,
  .bright-hope-mark::after {
    position: absolute;
    left: 50%;
    width: .08rem;
    height: .72rem;
    border-radius: 999px;
    background: #b9795f;
    content: '';
    transform-origin: center;
  }

  .bright-hope-mark::before {
    top: .14rem;
    transform: translateX(-50%) rotate(45deg);
  }

  .bright-hope-mark::after {
    bottom: .14rem;
    transform: translateX(-50%) rotate(-45deg);
  }

  .bright-hope-hero {
    display: grid;
    grid-template-columns: 1.28fr .72fr;
    min-height: 11.9rem;
    align-items: center;
    gap: .75rem;
    padding: 1.15rem 1rem 1rem 1.2rem;
    background: linear-gradient(135deg, #f5f0e8, #edf1ec);
  }

  .bright-hope-copy small {
    display: block;
    color: #8a5236;
    font-size: .36rem;
    font-weight: 800;
    letter-spacing: .11em;
  }

  .bright-hope-copy strong {
    display: block;
    max-width: 13rem;
    margin-top: .42rem;
    font-family: Georgia, serif;
    font-size: clamp(1.15rem, 3vw, 2rem);
    font-weight: 400;
    line-height: 1.04;
  }

  .bright-hope-copy p {
    max-width: 12rem;
    margin: .62rem 0 0;
    color: #46534f;
    font-size: .53rem;
    line-height: 1.5;
  }

  .bright-hope-copy em {
    background: #29483f;
    color: white;
  }

  .bright-hope-portrait {
    position: relative;
    min-height: 9.6rem;
    overflow: hidden;
    border-radius: 5rem 5rem .8rem .8rem;
    background:
      radial-gradient(circle at 50% 22%, rgba(255,255,255,.55), transparent 24%),
      linear-gradient(155deg, #c4d0c8, #82988d);
  }

  .portrait-head,
  .portrait-body {
    position: absolute;
    display: block;
    left: 50%;
    background: rgba(56,86,77,.64);
    transform: translateX(-50%);
  }

  .portrait-head {
    width: 2.45rem;
    height: 2.75rem;
    top: 1.8rem;
    border-radius: 48% 48% 44% 44%;
  }

  .portrait-body {
    width: 5.4rem;
    height: 5.8rem;
    bottom: -2.6rem;
    border-radius: 52% 52% 0 0;
  }

  .bright-hope-status {
    padding: .55rem .8rem;
    background: #29483f;
    color: #eaf0ec;
    font-size: .39rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-align: center;
  }

  /* Signal & Structure: energetic, modular, systems-focused. */
  .portfolio-preview--signal {
    background: linear-gradient(135deg, #c8f44d, #4657f2);
  }

  .signal-mini {
    background: #f7f7f2;
    color: #151a21;
  }

  .signal-shell {
    display: grid;
    grid-template-columns: .72fr 1.6fr;
    min-height: 17rem;
  }

  .signal-rail {
    display: flex;
    flex-direction: column;
    gap: .55rem;
    padding: .9rem .65rem;
    background: #151a21;
    color: #f7f7f2;
  }

  .signal-brand {
    margin-bottom: .55rem;
    font-size: .55rem;
    font-weight: 900;
    line-height: 1.05;
  }

  .signal-brand small {
    display: block;
    margin-top: .3rem;
    color: #c8f44d;
    font-size: .3rem;
    letter-spacing: .15em;
  }

  .signal-rail > span {
    display: block;
    height: .18rem;
    background: rgba(247,247,242,.22);
  }

  .signal-rail > span:nth-of-type(2) {
    width: 78%;
  }

  .signal-rail > span:nth-of-type(3) {
    width: 62%;
  }

  .signal-rail em {
    margin-top: auto;
    padding: .45rem .3rem;
    background: #c8f44d;
    color: #151a21;
    font-size: .28rem;
    font-style: normal;
    font-weight: 900;
    text-align: center;
  }

  .signal-copy {
    position: relative;
    overflow: hidden;
    padding: 1.2rem 1rem;
    background:
      linear-gradient(rgba(70,87,242,.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(70,87,242,.07) 1px, transparent 1px),
      #f7f7f2;
    background-size: 1rem 1rem;
  }

  .signal-copy > small {
    display: block;
    color: #526800;
    font-size: .34rem;
    font-weight: 900;
