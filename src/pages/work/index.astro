---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Our Work | Brighter Sites"
  description="Explore website concepts designed for therapists and counseling practices."
>
  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">Our work</p>
      <h1>Different practices deserve different websites.</h1>
      <p class="page-lead">
        We design around the personality, clients, and goals of each practice—not around one reusable look.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="portfolio-feature">
        <div class="portfolio-copy">
          <p class="eyebrow">Featured demo</p>
          <h2>Evergreen Counseling Collective</h2>
          <p>
            A warm, grounded counseling website built around soft greens,
            organic imagery, calm typography, and straightforward client navigation.
          </p>

          <div class="tag-row">
            <span>Warm</span>
            <span>Organic</span>
            <span>Grounded</span>
          </div>

          <a class="button" href="#" aria-disabled="true">
            Live demo coming soon
          </a>
        </div>

        <div class="portfolio-preview portfolio-preview--evergreen">
          <div class="preview-window">
            <div class="preview-top"></div>
            <div class="preview-body"></div>
          </div>
        </div>
      </article>
    </div>
  </section>
</Layout>
